{
  "hosting": [
    {
      "target": "furadmindashboard",
      "public": "furadmindashboard",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },

    {
      "target": "customerpwa",
      "public": "customerpwa/build/web",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
