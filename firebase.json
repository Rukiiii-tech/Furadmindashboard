{
  "hosting": [
    {
      "target": "furadmindashboard",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"]
    },

    {
      "target": "customerpwa",
      "public": "public",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        },
        {
          "source": "**",
          "destination": "build/web/index.html"
        }
      ]
    }
  ]
}
